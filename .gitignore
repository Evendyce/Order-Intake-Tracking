# Visual Studio local state and user-specific project settings
.vs/
*.user
*.suo
*.sln.docstates

# .NET build output (at any project depth)
[Bb]in/
[Oo]bj/
artifacts/

# Test results and coverage output
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml

# Angular and Node dependencies, builds, and caches
node_modules/
.angular/
.ng/
dist/
out-tsc/
.npm/
e2e/test-output/
*.tsbuildinfo

# Temporary files and package-manager diagnostic logs
/tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Syncfusion Visual Studio extension diagnostics outside application projects
Miscellaneous FilesError*.log

# Local environment overrides (keep example files shareable)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# LocalDB data files and local HTTPS certificates
*.mdf
*.ldf
*.ndf
*.pfx
*.p12
*.key

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Keep dependency lockfiles, Angular configuration, appsettings,
# migrations, and shared .vscode launch/tasks configuration in source control.
